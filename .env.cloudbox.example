# Cloud-box credentials — copy to .env on the box and fill in. Names only here;
# never commit values (core constraint 4). .env is gitignored.
#
# One filename on both machines: the `python -m` entry points load `.env` and
# nothing else, so there is no precedence question between a dev env file and
# this one (pipeline/env.py). This is the box's template, not its filename.
#
# Least-privilege split: the box gets ONLY what AIDE's agent runs and
# mlebench need. The spec-pipeline keys (VOYAGE_API_KEY, LANGSMITH_*) stay
# on the dev machine — no spec-pipeline LLM/embedding calls run on the box
# (core constraint 1). Do not add them here.

# AIDE's own agent-model calls from inside the container
ANTHROPIC_API_KEY=

# mlebench prepare downloads (join each competition on kaggle.com first)
KAGGLE_USERNAME=
KAGGLE_KEY=

# Persistent volume mount for prepared competition data (not a secret)
MLEBENCH_DATA_DIR=

# Where run outputs are written (not a secret). MUST be on the persistent
# volume — typically $MLEBENCH_DATA_DIR/prelude-results — or every artifact dies
# with the instance. Unset means the repo's results/ on the boot disk, which is
# right on the dev machine and wrong here; harness.batch refuses to terminate an
# instance whose results are still on the boot disk.
PRELUDE_RESULTS_DIR=

# Lambda instance control, required only by `harness.batch --terminate-on-done`.
# It is read at the END of a drain, so a missing key fails after every run has
# completed — leaving the box up and billing. Set both, or drain without
# --terminate-on-done and stop the box by hand.
LAMBDA_API_KEY=
LAMBDA_INSTANCE_ID=

# Experiment stage (not a secret). Selects the registry and artifact tree —
# results/runs_{stage}.jsonl and results/{stage}/ — and MUST match the stage the
# specs were built under on the dev machine. A mismatch is not silent corruption:
# the box finds nothing pending and drains no runs. Defaults to `dev` if unset,
# so eval drains have to set it. See docs/DATA.md.
PRELUDE_REGISTRY_STAGE=dev