# Copy to .env and fill in. Names only here — never commit values (core
# constraint 4). .env is gitignored.

# Required
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
MODEL=                      # dev: claude-haiku-4-5-20251001; eval runs use EVAL_MODEL (pipeline/config.py)
LANGSMITH_API_KEY=
LANGSMITH_TRACING_V2=       # true to trace pipeline runs
LANGSMITH_PROJECT=

# Optional
LLM_PROVIDER=               # anthropic (default) | ollama (wiring smoke-tests only)
OLLAMA_HOST=                # ollama backend only; default http://localhost:11434
OLLAMA_MODEL=               # ollama backend only
SIMILARITY_THRESHOLD=       # unset = None (v1 decision — see RESEARCH_DESIGN.md)
CHROMA_PATH=                # default data/chroma
